{
	"name": "digicreon/temma-project-api",
	"type": "project",
	"description": "Temma skeleton app for API projects",
	"homepage": "https://www.temma.net/",
	"keywords": [
		"framework",
		"php",
		"mvc",
		"api"
	],
	"license": "MIT",
	"authors": [
		{
			"name": "Amaury Bouchard",
			"email": "amaury@amaury.net"
		}
	],
	"require": {
		"php": ">=8.0",
		"digicreon/temma-lib": "^2.20.0"
	},
	"config": {
		"platform-check": true,
		"sort-packages": true
	},
	"scripts": {
		"temma-skills-sync": "@php -r \"file_exists('vendor/digicreon/temma-lib/skills/sync.php') && include('vendor/digicreon/temma-lib/skills/sync.php');\"",
		"post-create-project-cmd": [
			"chmod +x bin/comma",
			"chmod 777 log tmp",
			"ln -s ../vendor/digicreon/temma-lib/lib/smarty-plugins lib/smarty-plugins",
			"@temma-skills-sync"
		],
		"post-install-cmd": [
			"@temma-skills-sync"
		],
		"post-update-cmd": [
			"@temma-skills-sync"
		]
	},
	"support": {
		"docs": "https://www.temma.net/",
		"source": "https://github.com/Digicreon/Temma",
		"forum": "https://github.com/Digicreon/discussions",
		"issues": "https://github.com/Digicreon/Temma/issues"
	}
}
